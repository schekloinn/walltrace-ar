    <array><string>UIInterfaceOrientationPortrait</string></array>
    <key>UIRequiredDeviceCapabilities</key>
    <array><string>arm64</string><string>arkit</string></array>
    <key>UIUserInterfaceStyle</key><string>Dark</string>
